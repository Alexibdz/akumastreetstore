# Contraseña del panel (/admin). Cambiala antes de publicar la web.
ADMIN_PASSWORD=

# Clave para firmar la sesión del panel: cualquier texto largo al azar.
# Si la cambiás, se cierran todas las sesiones abiertas.
ADMIN_SECRET=

# URL pública del sitio (se usa en los links que se comparten por WhatsApp/Instagram)
SITE_URL=http://localhost:3000

# Opcionales: dónde guardar la base local y las fotos (por defecto ./data)
# DATABASE_PATH=./data/akuma.db
# UPLOADS_PATH=./data/uploads
